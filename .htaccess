# =============================================================
# .htaccess — cache control + hardening for LiteSpeed / Apache
# Goal: HTML always fresh, versioned assets (?v=) cached long,
# sensitive files blocked, baseline security headers set.
# =============================================================

# --- Do NOT let LiteSpeed cache the HTML pages ---
# This is what caused production to keep showing the old layout:
# the page itself was served from LiteSpeed cache. Keeping HTML
# uncached means a new ?v= on the CSS/JS link is always seen.
<IfModule LiteSpeed>
    RewriteEngine On
    # Disable LiteSpeed full-page cache for HTML documents
    RewriteRule .* - [E=Cache-Control:no-cache]
</IfModule>

# --- Block access to the git directory and dotfiles ---
RedirectMatch 404 /\.git
<IfModule mod_rewrite.c>
    RewriteEngine On
    # Deny any hidden dotfile/dir except .well-known (used by ACME/SSL)
    RewriteRule "(^|/)\.(?!well-known)" - [F,L]
</IfModule>

# --- Block sensitive project files from being served ---
<FilesMatch "(^\.htaccess$|\.(sh|md|bak|log|old|ini|env)$|^deploy\.sh$|^_purge\.php$|^README)">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    # HTML: never cache, always revalidate
    <FilesMatch "\.(html|htm)$">
        Header set Cache-Control "no-cache, no-store, must-revalidate"
        Header set Pragma "no-cache"
        Header set Expires "0"
    </FilesMatch>

    # Versioned static assets (css/js/images): safe to cache for a long time
    # because updating the file means bumping ?v=... in the HTML link.
    <FilesMatch "\.(css|js|jpg|jpeg|png|gif|svg|webp|woff|woff2|ttf|eot|ico)$">
        Header set Cache-Control "public, max-age=31536000"
    </FilesMatch>

    # --- Baseline security headers ---
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "DENY"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=()"
    # HSTS: enable only if the whole domain is HTTPS-only (it is here).
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
    # CSP: allows self + the two external CDNs this page relies on
    # (Google Fonts + Font Awesome) and the portfolio stats API.
    Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com https://cdnjs.cloudflare.com; font-src 'self' https://fonts.gstatic.com https://cdnjs.cloudflare.com; script-src 'self' 'unsafe-inline'; connect-src 'self' https://portfolio.dimasqiramadhani.com; manifest-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
</IfModule>

# --- Optional: gzip/deflate for faster delivery ---
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/json
</IfModule>
